<Window x:Class="WhaleLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鲸鲸" Icon="Assets/app.ico" Height="840" Width="1320" MinHeight="640" MinWidth="1080"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontSize="12.5"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- 背景图：只在设置里选过图片时显示；上面压一层主题蒙版保证可读 -->
        <Grid x:Name="BackdropLayer" Grid.RowSpan="3" Visibility="Collapsed"
              ClipToBounds="True" IsHitTestVisible="False">
            <Image x:Name="BackdropImage" Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <BlurEffect Radius="26" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
            <Border Background="{DynamicResource BackdropTint}" />
        </Grid>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="{DynamicResource BgTop}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,0" VerticalAlignment="Center" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 圆形比圆角方块更像「一个人」；渐变只两段，原三段最后一段落在可视区外 -->
                    <Border x:Name="BrandMark" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center"
                            Cursor="Hand" ToolTip="鲸鲸" MouseLeftButtonUp="OnBrandClick">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF7B8FE0" Offset="0" />
                                <GradientStop Color="#FF55C9E6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M4.2 17.6C8.8 17.4 12 14.6 13.2 9.8c1.2 4.8 4.4 7.6 9 7.8-1.3-5.2-4.9-8.6-9-8.6s-7.7 3.4-9 8.6Z"
                              Fill="White" Stretch="Uniform" Width="17" Height="17"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="鲸鲸" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource Text}" Margin="11,0,0,0" VerticalAlignment="Center" />

                    <Border Width="1" Height="20" Background="{DynamicResource Line}"
                            Margin="22,0,22,0" VerticalAlignment="Center" />

                    <!-- 三个胶囊合成一条：三盏灯 + 一句「她在做什么」。细节放 ToolTip，由 RefreshAsync 生成 -->
                    <Border x:Name="StatusStrip" Style="{StaticResource Chip}" Margin="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DotNode" Width="6" Height="6" Fill="{DynamicResource Idle}" />
                            <Ellipse x:Name="DotBridge" Width="6" Height="6" Fill="{DynamicResource Idle}" Margin="5,0,0,0" />
                            <Ellipse x:Name="DotWechat" Width="6" Height="6" Fill="{DynamicResource Idle}" Margin="5,0,0,0" />
                            <Border Width="1" Height="12" Background="{DynamicResource Line}" Margin="10,0,9,0" />
                            <TextBlock x:Name="StateSummary" Text="她睡着了" Foreground="{DynamicResource Text}"
                                       FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <!-- 彩蛋：23:00–05:00 且夜航主题时出现一枚小月亮 -->
                            <Path x:Name="IconNight" Data="M13.5 9.5A5 5 0 0 1 7 3a5.5 5.5 0 1 0 6.5 6.5Z"
                                  Stroke="{DynamicResource Gold}" StrokeThickness="1.2" Width="11" Height="11"
                                  Stretch="Uniform" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Visibility="Collapsed" ToolTip="夜里她还没睡" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnTheme" Style="{StaticResource TopBtn}" Width="34" Height="34" Padding="0" AutomationProperties.Name="切换浅色或深色"
                            Click="OnToggleTheme" ToolTip="切换浅色 / 深色">
                        <Grid Width="16" Height="16">
                            <Path x:Name="IconMoon"
                                  Data="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5 8.5 8.5 0 1 0 20.5 14.5Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7" StrokeLineJoin="Round" Stretch="Uniform" />
                            <Path x:Name="IconSun" Visibility="Collapsed"
                                  Data="M12 4v2 M12 18v2 M4 12h2 M18 12h2 M6.3 6.3l1.4 1.4 M16.3 16.3l1.4 1.4 M17.7 6.3l-1.4 1.4 M7.7 16.3l-1.4 1.4 M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                        </Grid>
                    </Button>
                    <Button x:Name="BtnSettings" Style="{StaticResource TopBtn}" Width="34" Height="34" Padding="0" AutomationProperties.Name="设置"
                            Click="OnSettings" ToolTip="设置">
                        <Path Data="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 1.56V21a2 2 0 1 1-4 0v-.09a1.7 1.7 0 0 0-1.1-1.56 1.7 1.7 0 0 0-1.88.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.56-1H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 8.9a1.7 1.7 0 0 0-.34-1.88l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.56V3a2 2 0 1 1 4 0v.09a1.7 1.7 0 0 0 1 1.56 1.7 1.7 0 0 0 1.88-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.12.4.5.86 1.56 1H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.51 1Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="BtnRestart" Style="{StaticResource Ghost}" Margin="6,0,0,0"
                            Click="OnRestart" ToolTip="先停内核与桥接，再按固定顺序重启">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M20 11a8 8 0 1 0-2.3 5.7 M20 5v6h-6"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="重启" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnToggle" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="OnToggle">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 3v9 M6.3 6.3a8 8 0 1 0 11.4 0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock x:Name="BtnToggleText" Text="停止" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 左栏 + 主区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="204" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource BgNav}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,16,14,16">

                    <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItem}"
                             IsSynchronizedWithCurrentItem="False"
                             SelectionChanged="OnNavChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <!-- 分组由 MainWindow.xaml.cs 的 CollectionView 提供；组头不可点，只做归类 -->
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource Dim}" Margin="12,10,0,5" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding Icon}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" Margin="11,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl x:Name="Host" Grid.Column="1" />
        </Grid>

        <!-- 底栏 -->
        <Border Grid.Row="2" Background="{DynamicResource BgTop}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="24,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusLine" DockPanel.Dock="Left" Text="启动器就绪"
                           Style="{StaticResource Small}" VerticalAlignment="Center" />
                <!-- 本次运行收到/回复了多少：把「她在干活」这件事放到眼前 -->
                <TextBlock x:Name="FootStats" DockPanel.Dock="Right" Text=""
                           Style="{StaticResource Small}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
