<UserControl x:Class="WhaleLauncher.Views.StatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="状态" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="⟳ 刷新" Style="{StaticResource Ghost}"
                    HorizontalAlignment="Right" Click="OnRefresh" />
        </DockPanel>

        <!-- 主卡（结论 + 三行明细）+ 副卡（用量）：1.6 : 1，不再是三等分 -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <!-- 一句话结论：这一屏真正要回答的是「她现在能不能回消息」 -->
                        <TextBlock x:Name="HealthLine" DockPanel.Dock="Left" Text="她还在睡"
                                   FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="BtnDiag" DockPanel.Dock="Right" Content="诊断" Style="{StaticResource Ghost}"
                                Padding="10,4" FontSize="11" VerticalAlignment="Center" Click="OnDiag"
                                ToolTip="打开诊断页看日志和发送失败原因" />
                    </DockPanel>

                    <!-- 内核 -->
                    <StackPanel Margin="0,16,0,0">
                        <DockPanel LastChildFill="False">
                            <Ellipse x:Name="DotNode" DockPanel.Dock="Left" Width="8" Height="8"
                                     Fill="{DynamicResource Idle}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left" Text="内核" Style="{StaticResource Label}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="NodeAge" DockPanel.Dock="Left" Style="{StaticResource Small}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="NodeMain" DockPanel.Dock="Right" Text="未启动"
                                       FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="NodeSub" Text="—" Style="{StaticResource Small}" Margin="16,4,0,0"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- 桥接 -->
                    <StackPanel Margin="0,14,0,0">
                        <DockPanel LastChildFill="False">
                            <Ellipse x:Name="DotBridge" DockPanel.Dock="Left" Width="8" Height="8"
                                     Fill="{DynamicResource Idle}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left" Text="桥接" Style="{StaticResource Label}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="BridgeAge" DockPanel.Dock="Left" Style="{StaticResource Small}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="BridgeMain" DockPanel.Dock="Right" Text="未启动"
                                       FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="BridgeSub" Text="—" Style="{StaticResource Small}" Margin="16,4,0,0"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- 微信 -->
                    <StackPanel Margin="0,14,0,0">
                        <DockPanel LastChildFill="False">
                            <Ellipse x:Name="DotWechat" DockPanel.Dock="Left" Width="8" Height="8"
                                     Fill="{DynamicResource Idle}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left" Text="微信" Style="{StaticResource Label}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="WechatMain" DockPanel.Dock="Right" Text="未知"
                                       FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock x:Name="WechatSub" Text="—" Style="{StaticResource Small}" Margin="16,4,0,0"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 副卡：本次收发 / 本轮用量 / 主动搭话。三行之间用细分隔线，不再各占一张卡 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <TextBlock x:Name="UsageLine" Text="本次运行  —" Style="{StaticResource Value}" />
                    <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,12,0,10" />
                    <TextBlock x:Name="RoundUsageLine" Text="本轮用量  —" Style="{StaticResource Small}"
                               TextWrapping="Wrap" LineHeight="17" />
                    <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,10,0,10" />
                    <TextBlock x:Name="CareLine" Text="主动搭话  —" Style="{StaticResource Small}"
                               TextWrapping="Wrap" LineHeight="17" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 最近动态 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="最近动态" Style="{StaticResource H2}" />
                    <TextBlock x:Name="RecentHint" DockPanel.Dock="Right" Style="{StaticResource Small}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <Grid>
                    <ListBox x:Name="Recent" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" Padding="0,4">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Who}" Foreground="{DynamicResource Muted}"
                                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{DynamicResource Text}"
                                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空态三段式：插画 + 一句人话。RecentEmpty 仍是 TextBlock（代码会改它的 Text） -->
                    <StackPanel x:Name="RecentEmptyBox" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M3 13c4.6-.3 7.7-2.8 9-7.7 1.3 4.9 4.4 7.4 9 7.7-1.3-5.2-4.9-8.6-9-8.6S4.3 7.8 3 13Z"
                              Stroke="{DynamicResource Accent}" StrokeThickness="1.1" Opacity="0.5"
                              Width="84" Height="40" Stretch="Uniform" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Accent}" Opacity="0.35" />
                            <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" Opacity="0.5" Margin="5,0,0,0" />
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" Opacity="0.65" Margin="5,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="RecentEmpty" Text="还没有消息。先在微信里跟她说一句。"
                                   Style="{StaticResource Small}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
