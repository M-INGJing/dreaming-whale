{
    "name": "whale-girl-bot",
    "version": "4.0.8",
    "private": false,
    "description": "鲸鲸 Whale Girl —— DeepSeek 微信聊天机器人（B站养鱼/表情包/语音/能力系统，零 npm 依赖）",
    "main": "server.js",
    "type": "commonjs",
    "scripts": {
        "start": "node server.js",
        "doctor": "node server.js --doctor",
        "test": "node --test \"tests/*.test.js\"",
        "check-layers": "node scripts/check-layers.js",
        "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke.ps1",
        "release-check": "node scripts/release-check.js --release",
        "privacy": "node scripts/privacy-scan.js .",
        "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
        "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
        "bump": "node scripts/bump-version.js",
        "ci": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ci-local.ps1"
    },
    "engines": {
        "node": ">=18"
    },
    "keywords": [
        "deepseek",
        "chatbot",
        "wechat",
        "wechat-bot",
        "wechat-robot",
        "bilibili",
        "bilibili-bot",
        "llm",
        "ai-companion",
        "sticker",
        "voice",
        "wpf",
        "零依赖"
    ],
    "license": "AGPL-3.0-only",
    "author": "M-INGJing (fork); original by Banan1cee/whale_girl contributors",
    "homepage": "https://github.com/M-INGJing/dreaming-whale#readme",
    "bugs": {
        "url": "https://github.com/M-INGJing/dreaming-whale/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/M-INGJing/dreaming-whale.git"
    }
}
